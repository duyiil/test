# 智测 ZhiTest Phase 1 环境变量示例。
# 复制为 .env 后按环境修改。不要把真实密钥提交到仓库。
# 下面的口令只是本地开发占位，不是生产密钥。

ZHITEST_ENV=development
DATABASE_URL=postgresql+psycopg://zhitest:zhitest@127.0.0.1:5432/zhitest
ZHITEST_AUTO_BOOTSTRAP=true
ZHITEST_ADMIN_USERNAME=admin
ZHITEST_ADMIN_PASSWORD=ChangeMe-Admin-2026
ZHITEST_ADMIN_DISPLAY_NAME=系统管理员
ZHITEST_SESSION_TTL_SECONDS=7200
ZHITEST_COOKIE_SECURE=false
ZHITEST_TRUST_PROXY=false
ZHITEST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
ZHITEST_LOG_LEVEL=INFO
# 显式允许本机演示服务。其他回环、私网和元数据地址默认拒绝。
ZHITEST_TARGET_ALLOWLIST=127.0.0.1,localhost,::1
# OpenAI 兼容接口。已核对 DeepSeek 的模型列表可用；密钥稍后由环境注入，不要写在这里。
ZHITEST_LLM_BASE_URL=https://api.deepseek.com
ZHITEST_LLM_MODEL=deepseek-chat
ZHITEST_LLM_API_KEY=
